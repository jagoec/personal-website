<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% if page.url == '/' %}{{ site.name }}{% else %}{{ title }} — {{ site.name }}{% endif %}</title>
        <link rel="stylesheet" href="/style.css">
        <link rel="canonical" href="{{ site.url }}{{ page.url }}">
        {% set desc = description or excerpt or site.description %}
        <meta name="description" content="{{ desc | replace('**', '') | escape }}">
        <meta property="og:site_name" content="{{ site.name }}">
        <meta property="og:type" content="{% if date %}article{% else %}website{% endif %}">
        <meta property="og:title" content="{% if page.url == '/' %}{{ site.name }}{% else %}{{ title }}{% endif %}">
        <meta property="og:description" content="{{ desc | replace('**', '') | escape }}">
        <meta property="og:url" content="{{ site.url }}{{ page.url }}">
        <meta property="og:image" content="{{ site.url }}{{ image or '/img/og-default.png' }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta name="twitter:card" content="summary_large_image">
        <script>
            window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
        </script>
        <script defer src="/_vercel/insights/script.js"></script>
    </head>
    <body>
        <nav>
            <a href="/">Home</a>
            <a href="/about/">About</a>
            <a href="/books/">Books</a>
            <a href="/blog/">Blog</a>
        </nav>
        <main>
            {{ content | safe }}
            {% if showStats %}
            <p class="page-stats">This about page contains {{ content | wordCount }} words, {{ content | charCount }} characters.</p>
            {% endif %}
        </main>
    </body>
</html>
